# Copy this file to ".env" and fill it in. Never share or publish the .env file.

# PayMongo secret key (Dashboard > Developers > API keys). Start with the TEST key: sk_test_...
# Leave empty to keep the built-in demo payment screen.
PAYMONGO_SECRET_KEY=

# Payment methods shown at checkout. Only list methods enabled on your PayMongo account.
PAYMONGO_METHODS=gcash,paymaya

# Public https address of this site once it is hosted, e.g. https://tickets.yourbarangay.ph
PUBLIC_URL=

# Filled in automatically by: npm run setup-webhook
PAYMONGO_WEBHOOK_SECRET=
